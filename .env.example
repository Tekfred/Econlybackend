NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/econly
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# SMTP is optional in local development (the OTP is printed to the backend log).
# Configure these values to deliver real reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
